<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ToolCommandName>replace</ToolCommandName>
    <PackAsTool>True</PackAsTool>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
	<AssemblyVersion>9.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
	<Version>9.0.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Artem Vertii</Authors>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>avs-replace</Title>
    <PackageProjectUrl></PackageProjectUrl>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/avertiy/avs-replace</RepositoryUrl>
    <AssemblyName>avs-replace</AssemblyName>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AVS.CoreLib.Extensions" Version="9.0.0" />
    <PackageReference Include="AVS.CoreLib.PowerConsole" Version="9.0.0" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Core\Commands\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
